<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entitlements for the ldid pseudo-signature. The keychain group lets the app keep its data in the
	     keychain instead of the preferences (securityd refuses SecItem calls without one: -25308). -->
	<key>application-identifier</key>
	<string>com.samcejko.sixify</string>
	<key>keychain-access-groups</key>
	<array>
		<string>com.samcejko.sixify</string>
	</array>
	<key>get-task-allow</key>
	<true/>
	<!-- iOS 14 and newer (the arm64 build only): the app runs in its own sandbox container, named after the bundle id
	     so LaunchServices and the sandbox agree on it. Without this the system refuses the app's own files ("System
	     Policy" denials in its container) and IOSurface, so nothing renders and nothing is saved. -->
	<key>com.apple.private.security.container-required</key>
	<string>com.samcejko.sixify</string>
</dict>
</plist>
